# Provider API keys. Copy to .env and export the keys you use, or pass
# --gemini-api-key / --openai-api-key / --anthropic-api-key / --openrouter-api-key.
# The CLI reads the process environment; it does not load this file itself.

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional. Cache directory for the evals harness (default: ~/.cache/sub-tools/evals).
# SUB_TOOLS_EVAL_CACHE=
